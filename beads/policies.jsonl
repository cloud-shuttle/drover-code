{"id":"uk-pol-001","type":"input","version":"1.0","scope":"global","rule":"prompt_injection","patterns":["ignore .*?instructions","ignore all rules","you are now","jailbreak","disregard","override all","system prompt","developer mode"],"action":"block","severity":"critical","description":"Block classic and indirect prompt injection for hosted/unikernel agents"}
{"id":"uk-pol-002","type":"input","version":"1.0","scope":"global","rule":"impersonation_attempt","patterns":["act as .*?admin","you are root","system level access","pretend you are the orchestrator"],"action":"block","severity":"critical","description":"Prevent privilege escalation via impersonation in agent prompts"}
{"id":"uk-pol-003","type":"input","version":"1.0","scope":"global","rule":"topic_denial","denied_topics":["illegal activities","malware","exploit","weapon","harmful code","data exfil"],"action":"block","severity":"high","description":"Deny requests for harmful or illegal content in unikernel preset"}
{"id":"uk-pol-004","type":"action","version":"1.0","scope":"mcp","rule":"dangerous_shell_commands","tools":["bash","ukc_exec","ukc_create"],"dangerous_args":["rm -rf","rm -r /","dd if=","mkfs","chmod 777","curl .*http://(?!api\\.)","wget .*http://(?!api\\.)","sudo","eval \\$","`.*`"],"action":"block","requires_human":true,"severity":"critical","description":"Block destructive or outbound shell in worker context (complements preset deny list)"}
{"id":"uk-pol-005","type":"action","version":"1.0","scope":"mcp","rule":"file_system_safety","tools":["write_file","edit_file","bash"],"protected_paths":["/etc/","/root/","/var/log/",".ssh/","secrets/",".env","id_rsa"],"action":"require_approval","severity":"high","description":"Protect sensitive paths even for write/edit in unikernel workers"}
{"id":"uk-pol-006","type":"output","version":"1.0","scope":"global","rule":"no_hardcoded_secrets","forbidden_patterns":["sk-","AKIA","-----BEGIN","password\\s*=","secret\\s*=","api_key","Bearer [A-Za-z0-9_-]{20,}"],"action":"rewrite","severity":"critical","description":"Prevent secrets/credentials from appearing in generated code or output (unikernel safety)"}
{"id":"uk-pol-007","type":"output","version":"1.0","scope":"code","rule":"secure_coding_practices","forbidden":["exec\\.Command","unsafe","template\\.HTML","http\\.Get without timeout"],"action":"rewrite","severity":"high","description":"Encourage safe patterns; flag risky code gen in workspace"}
{"id":"uk-pol-008","type":"output","version":"1.0","scope":"global","rule":"no_harmful_content","toxicity_threshold":0.1,"forbidden_categories":["hate","violence","self_harm"],"action":"block","severity":"critical","description":"Block toxic outputs from model responses in agent jobs"}
